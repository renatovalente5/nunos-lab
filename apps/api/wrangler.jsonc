// O Worker do Nuno's Lab: a API e a base. Não há segredos: as sessões são
// testemunhos aleatórios e a base só guarda o resumo deles.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nunos-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  // A base nasceu com «--jurisdiction=eu» a 21 out 2026; isso é uma
  // propriedade da base, não deste ficheiro. O código fala com o BINDING «DB».
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nunos-lab",
      "database_id": "03a1f41b-7ea3-42fc-a995-4ce5223af8eb",
      "migrations_dir": "../../base/migracoes",
      "migrations_table": "d1_migrations",
    },
  ],
  // Travões por IP: entrar no backoffice, na app e na Balcão (30 por minuto) e as contagens da
  // app (60 por minuto). O namespace_id é único na conta (o Carimbo usa os 1000
  // e os 2000, o Armazém o 1101).
  "ratelimits": [
    { "name": "TRAVAO", "namespace_id": "7101", "simple": { "limit": 30, "period": 60 } },
    { "name": "CONTAR", "namespace_id": "7102", "simple": { "limit": 60, "period": 60 } },
    // Carimbos por sessão da Balcão (uma fila sem rede a despejar cabe aqui).
    { "name": "CARIMBAR", "namespace_id": "7103", "simple": { "limit": 60, "period": 60 } },
  ],
  // A limpeza da madrugada: ligações e sessões caducadas, imagens sem dono.
  "triggers": { "crons": ["23 3 * * *"] },
  "vars": {
    // A app e o backoffice vivem no GitHub Pages; a API só responde a esta origem.
    // No «wrangler dev», o .dev.vars sobrepõe-na com as do localhost.
    "ORIGENS": "https://renatovalente5.github.io",
    // O cliente do «Entrar com o Google» (projecto «Nuno's Lab» no Google Cloud
    // do Renato, criado a 22 out 2026). É público: identifica a app, não abre nada.
    "GOOGLE_CLIENTE": "695283550331-vert2ikpluksqb954jl0j3ed0ukphha4.apps.googleusercontent.com",
    // «Entrar com a Apple»: o Services ID (web) e o bundle id (app nativa),
    // separados por vírgulas. Vazio: o botão da Apple não aparece.
    "APPLE_CLIENTES": "pt.nunoslab.web,pt.nunoslab.app,pt.nunoslab.balcao",
    // A Wallet da Apple: o Pass Type ID, a equipa, a chave da APNs (o id; a
    // chave é segredo) e a morada desta API, que fica dentro de cada passe.
    "APPLE_PASS_TIPO": "pass.pt.nunoslab.cartao",
    "APPLE_EQUIPA": "6M2QCLR98V",
    "APNS_KID": "S639DA6BXD",
    "ORIGEM_DA_API": "https://nunos-lab.renato-lima-valente-dcb.workers.dev",
    // A Google Wallet: o emissor (a conta de serviço é segredo).
    "GOOGLE_WALLET_EMISSOR": "3388000000023200429",
  },
  // Os segredos (wrangler secret put): APPLE_CERTIFICADO, APPLE_CHAVE, APPLE_CADEIA,
  // APNS_CHAVE, WALLET_SEGREDO, GOOGLE_WALLET_CONTA, GOOGLE_WALLET_EMISSOR.
}
