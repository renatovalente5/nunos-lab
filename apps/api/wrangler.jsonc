// O Worker do Nuno's Lab: a API e a base. Não há segredos: as sessões são
// testemunhos aleatórios e a base só guarda o resumo deles.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nunos-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  // A base nasceu com «--jurisdiction=eu» a 21 out 2026; isso é uma
  // propriedade da base, não deste ficheiro. O código fala com o BINDING «DB».
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nunos-lab",
      "database_id": "03a1f41b-7ea3-42fc-a995-4ce5223af8eb",
      "migrations_dir": "../../base/migracoes",
      "migrations_table": "d1_migrations",
    },
  ],
  // Travões por IP: entrar no backoffice, na app e na Balcão (30 por minuto) e as contagens da
  // app (60 por minuto). O namespace_id é único na conta (o Carimbo usa os 1000
  // e os 2000, o Armazém o 1101).
  "ratelimits": [
    { "name": "TRAVAO", "namespace_id": "7101", "simple": { "limit": 30, "period": 60 } },
    { "name": "CONTAR", "namespace_id": "7102", "simple": { "limit": 60, "period": 60 } },
    // Carimbos por sessão da Balcão (uma fila sem rede a despejar cabe aqui).
    { "name": "CARIMBAR", "namespace_id": "7103", "simple": { "limit": 60, "period": 60 } },
    // Procuras de clientes por sessão da Balcão (30 por minuto): uma sessão perdida não despeja a lista.
    { "name": "PROCURAR", "namespace_id": "7104", "simple": { "limit": 30, "period": 60 } },
    // Usos do saldo por sessão da Balcão (20 por minuto): uma sessão roubada não esvazia saldos em série.
    { "name": "USAR_SALDO", "namespace_id": "7105", "simple": { "limit": 20, "period": 60 } },
  ],
  // O código para entrar na for partners por email (28 nov 2026), pelo Email Sending da conta. Até o
  // nunoslab.com estar na Cloudflare sai do carimbodigital.pt (decisão do Renato, 28 nov); depois troca-se
  // aqui e no EMAIL_REMETENTE para app@nunoslab.com. Sem o binding, a for partners não mostra o botão.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["nunoslab@carimbodigital.pt"] }],
  // O Workers AI da conta: traduz para inglês o que o backoffice guarda só em português
  // (src/traducao.ts). No «wrangler dev» também vai à Cloudflare (conta no gratuito diário).
  "ai": { "binding": "AI" },
  // A limpeza da madrugada: ligações e sessões caducadas, imagens sem dono.
  "triggers": { "crons": ["23 3 * * *"] },
  // Os avisos dos passes quando mudam todos (barbearias, programa, VERSAO_DO_PASSE): uma mensagem
  // por série da Apple e por cartão da Google. Saíram do waitUntil (só 30 s depois da resposta, que
  // a 26 nov 2026 já não chegavam): cada lote tem 15 minutos. Um lote de cada vez, para o bilhete
  // da APNs se renovar num sítio só; o que falha volta daqui a um minuto, até 3 vezes. A fila
  // cria-se uma vez, antes de publicar: npx wrangler queues create nunos-lab-passes
  "queues": {
    "producers": [{ "binding": "PASSES", "queue": "nunos-lab-passes" }],
    "consumers": [
      {
        "queue": "nunos-lab-passes",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 3,
      },
    ],
  },
  "vars": {
    // A app e o backoffice vivem no GitHub Pages; a API só responde a esta origem.
    // No «wrangler dev», o .dev.vars sobrepõe-na com as do localhost.
    "ORIGENS": "https://renatovalente5.github.io",
    // O cliente do «Entrar com o Google» (projecto «Nuno's Lab» no Google Cloud
    // do Renato, criado a 22 out 2026). É público: identifica a app, não abre nada.
    "GOOGLE_CLIENTE": "695283550331-vert2ikpluksqb954jl0j3ed0ukphha4.apps.googleusercontent.com",
    // «Entrar com a Apple»: o Services ID (web) e o bundle id (app nativa),
    // separados por vírgulas. Vazio: o botão da Apple não aparece.
    "APPLE_CLIENTES": "pt.nunoslab.web,pt.nunoslab.app,pt.nunoslab.balcao",
    // A Wallet da Apple: o Pass Type ID, a equipa, a chave da APNs (o id; a
    // chave é segredo) e a morada desta API, que fica dentro de cada passe.
    "APPLE_PASS_TIPO": "pass.pt.nunoslab.cartao",
    "APPLE_EQUIPA": "6M2QCLR98V",
    "APNS_KID": "S639DA6BXD",
    "ORIGEM_DA_API": "https://nunos-lab.renato-lima-valente-dcb.workers.dev",
    // A Google Wallet: o emissor (a conta de serviço é segredo).
    "GOOGLE_WALLET_EMISSOR": "3388000000023200429",
    // O mapa das casas (Apple Maps Web Snapshots): o id da chave MapKit «Nunos Lab
    // mapas» da conta do Renato (a chave é segredo, MAPKIT_CHAVE, em ~/Chaves/nunos-lab/).
    "MAPKIT_KID": "N4V99P8Y3W",
    // A conta da revisão das lojas na for partners: a pessoa «App Review» (barbeiro da Nogueira, criada a
    // 8 nov 2026 para a Apple). A API prende-a aos clientes de exemplo; não se apaga entre versões.
    "REVISAO_PESSOA": "908",
    // O remetente do código por email (com o nome «Nuno's Lab for partners»): ver o send_email acima.
    "EMAIL_REMETENTE": "nunoslab@carimbodigital.pt",
  },
  // Os segredos (wrangler secret put): APPLE_CERTIFICADO, APPLE_CHAVE, APPLE_CADEIA,
  // APNS_CHAVE, WALLET_SEGREDO, GOOGLE_WALLET_CONTA, MAPKIT_CHAVE.
}
