    "migrar:remoto": "wrangler d1 migrations apply DB --remote",
    "publicar": "wrangler deploy"
  },
  "dependencies": {
    "@nunos-lab/dominio": "*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "wrangler": "^4.151.3"
  }
}
