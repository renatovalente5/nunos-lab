{
  "name": "@nunos-lab/api",
  "version": "0.1.0",
  "private": true,
  "description": "O Worker do Nuno's Lab: a API, a base e as imagens",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8870 --var MODO:desenvolvimento",
    "tipos": "wrangler types",
    "verificar": "tsc --noEmit",
