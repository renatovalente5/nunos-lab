{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.15.1"
    },
    "simulador": {
      "extends": "base",
      "channel": "simulador",
      "ios": { "simulator": true },
      "android": { "buildType": "apk" },
      "distribution": "internal"
    },
    "interna": {
      "extends": "base",
      "channel": "interna",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "producao": {
      "extends": "base",
      "channel": "producao",
      "autoIncrement": true
    }
  },
  "submit": {
    "producao": {
      "ios": { "appleTeamId": "6M2QCLR98V" },
      "android": { "track": "internal", "releaseStatus": "completed" }
    }
  }
}
