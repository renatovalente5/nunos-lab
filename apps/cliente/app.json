{
  "expo": {
    "name": "Nuno's Lab",
    "slug": "nunos-lab",
    "owner": "renatovalente5",
    "scheme": "nunoslab",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1c21bab2-48c0-494a-b145-9cbce22e24fa"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "bundleIdentifier": "pt.nunoslab.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-PT",
        "CFBundleName": "Nuno's Lab"
      }
    },
    "android": {
      "package": "pt.nunoslab.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Nuno's Lab",
      "shortName": "Nuno's Lab",
      "lang": "pt-PT",
      "themeColor": "#0A0A0A",
      "backgroundColor": "#0A0A0A",
      "description": "Vantagens nos parceiros do Nuno's Lab."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.695283550331-3vfcet7e138uqd7l18l1ebasst07mo93"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/nunos-lab"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1c21bab2-48c0-494a-b145-9cbce22e24fa"
      }
    }
  }
}
