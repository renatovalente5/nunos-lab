{
  "expo": {
    "name": "Nuno's Lab Balcao",
    "slug": "nunos-lab-balcao",
    "owner": "renatovalente5",
    "scheme": "nunoslab-balcao",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/48dd1aac-1c42-4cc7-9a05-d05c19c07e5c"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "bundleIdentifier": "pt.nunoslab.balcao",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-PT",
        "CFBundleName": "Balcão NL",
        "CFBundleDisplayName": "Balcão NL"
      }
    },
    "android": {
      "package": "pt.nunoslab.balcao",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Nuno's Lab Balcão",
      "shortName": "Balcão",
      "lang": "pt-PT",
      "themeColor": "#0A0A0A",
      "backgroundColor": "#0A0A0A",
      "description": "A Balcão do Nuno's Lab: ler o cartão e carimbar."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "A Balcão usa a câmara para ler o cartão do cliente.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.695283550331-1hvqg288aj8dcvmjmu9njnte9cu0ji9d"
        }
      ],
      [
        "./plugins/nome-android",
        {
          "nome": "Balcão NL"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/nunos-lab/balcao"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "48dd1aac-1c42-4cc7-9a05-d05c19c07e5c"
      }
    }
  }
}
